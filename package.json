    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
