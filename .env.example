# ===========================================
# Arjun Varma Portfolio - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# ------------------------------------------
# AI Chat Configuration (Required for chat)
# ------------------------------------------

# OpenRouter API Key - Get yours at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxx

# Model to use (optional, defaults to openai/gpt-4o-mini)
# Other options: anthropic/claude-3-haiku, google/gemini-flash-1.5
OPENROUTER_MODEL=openai/gpt-4o-mini

# ------------------------------------------
# OpenRouter Attribution (Optional)
# ------------------------------------------

# Your site URL (helps OpenRouter with analytics)
OR_SITE_URL=https://your-domain.com

# Your app name (appears in OpenRouter dashboard)
OR_APP_NAME=Arjun Varma Portfolio
